# Neon Postgres 连接串（Vercel Dashboard → Storage 创建后自动注入，本地手动复制）
DATABASE_URL="postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# 会话签名密钥（openssl rand -hex 32 生成）
JWT_SECRET="change-me-to-a-random-64-char-hex"

# 种子管理员账号（仅 db:seed 使用）
ADMIN_EMAIL="admin@arcadehub.local"
ADMIN_PASSWORD="Arcade@2026"
